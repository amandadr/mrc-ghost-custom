{{#contentFor "body_class"}} mrc-route-services-organizations-institutions{{/contentFor}}
{{#contentFor "head"}}
    <meta name="description" content="Secure, accessible systems for NGOs, industry associations, and municipalities in Atlantic Canada. Build digital capacity that survives staff turnover.">
    <meta property="og:title" content="Digital infrastructure that outlasts your board">
    <meta property="og:description" content="Practical systems for institutions that need accessibility, security, and governance without adding permanent technical staff.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{@site.url}}/services/organizations-institutions/">
    <link rel="canonical" href="{{@site.url}}/services/organizations-institutions/">
{{/contentFor}}

<main class="site-main mrc-page mrc-page-audience mrc-page-audience--organizations-institutions">
  <div class="mrc-audience-breadcrumb-wrap section-light gh-outer">
    <div class="gh-inner">
      {{> "audience-breadcrumb" current_label="Organizations & Institutions" path="/services/organizations-institutions/"}}
    </div>
  </div>

  {{! 1. Hero }}
  {{> "audience-hero"
    eyebrow="Organizations &amp; institutions"
    title="Secure, accessible systems for the public you serve."
    lead="Industry associations, non-governmental organizations (NGOs), and municipalities in Atlantic Canada face unique digital pressures. You need secure, accessible systems that serve your members, protect your data, and survive staff turnover."
    primary_href="/case-studies/"
    primary_text="Work"
    secondary_href="/contact/?audience=organizations-institutions"
    secondary_text="Contact"
    ga_audience="organizations_institutions"
    ga_label_primary="Work"
    ga_label_secondary="Contact"
    fit_heading="The reality of institutional work"
    fit_item1="Managing complex stakeholder and member needs"
    fit_item2="Strict accessibility and public-facing compliance"
    fit_item3="High stakes for data security and governance"
  }}

  {{! 2. Institutional Challenges (Pain Points) }}
  <section class="mrc-audience-challenges section-surface gh-outer" aria-labelledby="mrc-org-complexity">
    <div class="mrc-audience-challenges__inner gh-inner">
      {{> "section-header"
        eyebrow="Institutional Challenges"
        heading_id="mrc-org-complexity"
        heading="Where institutional complexity breaks down."
        intro="Large organizations rarely have one simple problem. They have interconnected systems where a change in leadership or a gap in security can affect everything else."
      }}
      <div class="mrc-audience-challenge-grid">
        {{> "audience-challenge" icon="users" title="Knowledge loss" copy="When a key staff member or executive director leaves, they take the website passwords and system knowledge with them."}}
        {{> "audience-challenge" icon="document" title="Member friction" copy="Industry associations and chambers of commerce spend too much time manually processing renewals and answering basic questions."}}
        {{> "audience-challenge" icon="key" title="Data silos & security" copy="Sensitive community data is scattered across personal emails and outdated spreadsheets, creating a massive security risk."}}
        {{> "audience-challenge" icon="accessibility" title="Accessibility compliance" copy="As a public-facing entity or municipality, your website fails to meet the strict accessibility standards required for all citizens."}}
        {{> "audience-challenge" icon="plug" title="Patchwork technology" copy="You are running a non-governmental organization (NGO) on five different free software tools that refuse to communicate with each other."}}
        {{> "audience-challenge" icon="compass" title="Public perception" copy="Your digital presence looks outdated, undermining the professional authority you need to secure funding and public trust."}}
      </div>
    </div>
  </section>

  {{! 3. What I do }}
  <section class="mrc-section section-light gh-outer" aria-labelledby="mrc-org-services">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="What I do"
        heading_id="mrc-org-services"
        heading="Help where you need it most"
      }}
      <div class="mrc-feature-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "feature-item" icon="key" title="Secure Digital Governance" body="Role-based access and secure architecture so your board and staff have the right permissions without compromising data."}}
        {{> "feature-item" icon="users" title="Member & Stakeholder Portals" body="Centralized hubs for industry groups like the Tourism Industry Association to manage directories, resources, and automated renewals."}}
        {{> "feature-item" icon="gear" title="Systems Integration" body="Connecting your donor databases, newsletters, and websites so your team can stop doing double data entry."}}
        {{> "feature-item" icon="accessibility" title="Strict Accessibility Standards" body="Websites built to meet or exceed provincial and federal accessibility guidelines, ensuring equitable access for the public."}}
        {{> "feature-item" icon="desktop" title="Legacy System Modernization" body="Safely migrating your organization off 15-year-old servers and outdated platforms onto modern, sustainable infrastructure."}}
        {{> "feature-item" icon="document" title="Clear Documentation & Training" body="Comprehensive manuals and handover training so your next executive director isn't left guessing how the website works."}}
      </div>
    </div>
  </section>

  {{! 4. Mid-page CTA }}
  {{> "cta-section"
    headline="Ready to modernize your organization's infrastructure?"
    subtext="Let's look at your current systems and find ways to improve security, accessibility, and operational efficiency."
    button_text="Get in touch"
    href="/contact/"
    ga_event="org_mid_cta_click"
    ga_label="Get in touch"
    ga_page_section="mid_cta"
  }}

  {{! 5. Work }}
  {{> "feed-work"
    section_class="section-surface"
    heading_id="mrc-org-work"
    eyebrow="Work"
    heading="A system built to be handed over"
    intro="Selected institutional work. Real projects that survived staff turnover and board changes."
    link_href="/case-studies/"
    link_text="View all"
    limit="3"
  }}

  {{! 6. Process }}
  <section class="mrc-section section-dark gh-outer" aria-labelledby="mrc-org-process">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Process"
        heading_id="mrc-org-process"
        heading="Work that transfers to you"
        intro="We build the system together, then hand you the keys. Your team runs it without needing to call me every week."
      }}
      <div class="mrc-process-grid mrc-process-grid--numbered mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "process-step" title="Stakeholder alignment" desc="We build consensus with your board of directors and executive team to ensure the project meets long-term strategic goals."}}
        {{> "process-step" title="Security & architecture planning" desc="We map out data flows, privacy requirements, and user roles before writing a single line of code."}}
        {{> "process-step" title="Sustainable implementation" desc="I build robust systems that don't require an expensive, permanent IT department to maintain."}}
        {{> "process-step" title="Institutional handover" desc="Your organization receives complete documentation, ensuring the system survives future leadership transitions."}}
      </div>
    </div>
  </section>

  {{! 7. Resources }}
  {{> "feed-resources"
    section_class="section-surface"
    heading_id="mrc-org-resources"
    eyebrow="Resources"
    heading="Useful reading for institutions"
    intro="Guides and checklists to help your organization make better digital decisions."
    link_href="/resources/"
    link_text="View all"
    limit="3"
  }}

  {{! 8. Final CTA }}
  {{> "cta-section"
    headline="Let's build a digital presence your community can trust."
    subtext="Start a conversation about improving your accessibility, securing your data, and serving your stakeholders better."
    button_text="Contact"
    href="/contact/?audience=organizations-institutions"
    secondary_href="/case-studies/"
    secondary_text="Work"
    ga_event="audience_primary_cta_click"
    ga_label="Contact"
    ga_audience="organizations_institutions"
    ga_page_section="final_cta"
  }}

  <div class="mrc-audience-nav section-light gh-outer">
    <div class="mrc-audience-nav__inner gh-inner">
      {{> "audience-related-nav" omit="organizations-institutions" audience="organizations_institutions"}}
    </div>
  </div>
</main>
