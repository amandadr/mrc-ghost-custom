{{!< default}}
{{! Agencies & Development Teams — /services/agencies-development-teams/
    Copy: assets/wireframes/raw copy/agencies-dev-teams.md (skip Relume lorem blocks). }}
{{#contentFor "title"}}Overflow Capacity for Atlantic Canada Agencies | Manny Roy Consulting{{/contentFor}}
{{#contentFor "body_class"}} mrc-route-services-agencies-development-teams{{/contentFor}}
{{#contentFor "head"}}
    <meta name="description" content="Senior engineering overflow for agencies and in-house development teams in Atlantic Canada. You keep the client. I ship maintainable work inside your process.">
    <meta property="og:title" content="Overflow capacity for Atlantic Canada agencies">
    <meta property="og:description" content="Clear the backlog without another full-time hire. Hands-on development, accessibility, and architecture that slots into your sprint.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{@site.url}}/services/agencies-development-teams/">
    <link rel="canonical" href="{{@site.url}}/services/agencies-development-teams/">
{{/contentFor}}

<main class="site-main mrc-page mrc-page-audience mrc-page-audience--agencies-development-teams">
  <div class="mrc-audience-breadcrumb-wrap section-light gh-outer">
    <div class="gh-inner">
      {{> "audience-breadcrumb" current_label="Agencies & Development Teams" path="/services/agencies-development-teams/"}}
    </div>
  </div>

  {{! 1. Hero }}
  <section class="mrc-audience-hero section-light gh-outer" aria-labelledby="mrc-audience-hero-title">
    <div class="mrc-audience-hero__inner gh-inner">
      <div class="mrc-audience-hero__content">
        <p class="mrc-audience-hero__eyebrow">Agencies &amp; development teams</p>
        <h1 id="mrc-audience-hero-title" class="mrc-audience-hero__title">Clear the backlog without another full-time hire.</h1>
        <p class="mrc-audience-hero__lead">Charlottetown shops, Halifax agencies, and in-house product teams across Atlantic Canada are shipping with a thin senior bench. I drop into your tools, write code your team can maintain, and stay off the client relationship.</p>
        <div class="mrc-audience-hero__actions mrc-cluster">
          <a href="{{@site.url}}/case-studies/" class="button mrc-btn-primary" data-ga-event="audience_primary_cta_click" data-ga-category="engagement" data-ga-label="Work" data-ga-audience="agencies_development_teams" data-ga-page-section="hero">Work</a>
          <a href="{{@site.url}}/contact/?audience=agencies-development-teams" class="button mrc-btn-secondary" data-ga-event="audience_secondary_cta_click" data-ga-category="engagement" data-ga-label="Contact" data-ga-audience="agencies_development_teams" data-ga-page-section="hero">Contact</a>
        </div>
      </div>
      {{> "audience-fit-card"
        heading="How I partner"
        item1="You keep the client and the process"
        item2="I work in your repo, board, and timezone"
        item3="Handoff with notes your team can actually use"
      }}
    </div>
  </section>

  {{! 2. Agency Reality (Pain Points) }}
  <section class="mrc-audience-challenges section-surface gh-outer" aria-labelledby="mrc-agency-reality">
    <div class="mrc-audience-challenges__inner gh-inner">
      {{> "section-header"
        eyebrow="Agency Reality"
        heading_id="mrc-agency-reality"
        heading="The work is there. The senior people are not."
        intro="Members of the PEI Information Technology Alliance and small shops from Summerside to Halifax know this already: the talent pool is thin, the pipeline is not, and a messy freelancer can cost you the client."
      }}
      <div class="mrc-audience-challenge-grid">
        {{> "audience-challenge" icon="users" title="Thin senior bench" copy="You can hire juniors. Finding a senior engineer, accessibility specialist, or technical search person on the Island is another story."}}
        {{> "audience-challenge" icon="calendar" title="Wave work, not a year-round seat" copy="Tourism launches, grant deadlines, and government projects arrive in bunches. A full-time senior hire sits idle between them."}}
        {{> "audience-challenge" icon="plug" title="Freelancer roulette" copy="One person, no cover, and they go quiet mid-sprint. Your project manager is left explaining the gap to the client."}}
        {{> "audience-challenge" icon="key" title="Client risk" copy="One sloppy white-label handoff can damage a relationship you spent years building. You need someone who stays in the background."}}
        {{> "audience-challenge" icon="accessibility" title="Standards debt" copy="Accessibility and technical search get deferred until a government, arts, or municipal client asks — and then the sprint blows up."}}
        {{> "audience-challenge" icon="compass" title="Timezone lag" copy="Overnight offshore handoffs miss Atlantic Time standups, Canadian privacy requirements, and the context of Island clients."}}
      </div>
    </div>
  </section>

  {{! 3. What I do }}
  <section class="mrc-section section-light gh-outer" aria-labelledby="mrc-agency-services">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="What I do"
        heading_id="mrc-agency-services"
        heading="Capacity that slots into your sprint"
      }}
      <div class="mrc-feature-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "feature-item" icon="gear" title="Hands-on development" body="Front-end and back-end overflow in React, Next.js, WordPress, Ghost, and the rest of the stack your clients already run."}}
        {{> "feature-item" icon="document" title="White-label delivery" body="Staging-ready builds under your brand. You own the relationship. I stay off the call unless you want me on it."}}
        {{> "feature-item" icon="accessibility" title="Accessibility remediation" body="Fixes against the Web Content Accessibility Guidelines without a redesign, so government and community clients can actually launch."}}
        {{> "feature-item" icon="chart" title="Technical search audits" body="A clear punch list for ranking, performance, and crawl issues — then the pull requests to close them."}}
        {{> "feature-item" icon="compass" title="Architecture & second opinions" body="Stack decisions, migration risk, and rescue work before a bad call costs you a quarter."}}
        {{> "feature-item" icon="desktop" title="Quality assurance & handoff" body="I test, document, and leave notes your developers can maintain. No mystery code, no hostage retainers."}}
      </div>
    </div>
  </section>

  {{! 4. Toolkit }}
  <section class="mrc-section section-surface gh-outer" aria-labelledby="mrc-agency-tech">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Toolkit"
        heading_id="mrc-agency-tech"
        heading="Technologies I work with"
      }}
      <div class="mrc-carousel-wrap" data-mrc-carousel>
        <div class="mrc-carousel">
          {{> "tech-card" simple_icon="wordpress" title="WordPress"}}
          {{> "tech-card" simple_icon="react" simple_icon_2="nextdotjs" title="React / Next.js"}}
          {{> "tech-card" simple_icon="cloudflare" title="Cloudflare"}}
          {{> "tech-card" simple_icon="godaddy" title="GoDaddy"}}
          {{> "tech-card" simple_icon="shopify" title="Shopify"}}
          {{> "tech-card" simple_icon="gitlab" title="GitLab"}}
          {{> "tech-card" simple_icon="webflow" title="Webflow"}}
          {{> "tech-card" simple_icon="googleanalytics" title="Google Analytics 4"}}
          {{> "tech-card" simple_icon="looker" title="Looker Studio"}}
          {{> "tech-card" simple_icon="ghost" title="Ghost CMS"}}
          {{> "tech-card" simple_icon="googlebigquery" title="BigQuery"}}
          {{> "tech-card" simple_icon="supabase" title="Supabase"}}
        </div>
        <div class="mrc-carousel__controls">
          <button type="button" class="mrc-carousel__btn" data-carousel-prev aria-label="Previous">{{> "icon" name="arrow-left"}}</button>
          <button type="button" class="mrc-carousel__btn" data-carousel-next aria-label="Next">{{> "icon" name="arrow-right"}}</button>
        </div>
      </div>
    </div>
  </section>

  {{! 5. Mid-page CTA }}
  {{> "cta-section"
    headline="Need another pair of hands on a live project?"
    subtext="Bring me into the sprint as overflow capacity. I work in your repo and your tools, then hand the work back to your team."
    button_text="Get in touch"
    href="/contact/?audience=agencies-development-teams"
    ga_event="agency_mid_cta_click"
    ga_label="Get in touch"
    ga_audience="agencies_development_teams"
    ga_page_section="mid_cta"
  }}

  {{! 6. Work }}
  <section class="mrc-section section-light gh-outer" aria-labelledby="mrc-agency-work">
    <div class="gh-inner">
      {{> "section-header" layout="split" eyebrow="Work" heading_id="mrc-agency-work" heading="Selected collaborations with teams" intro="Projects where I worked inside someone else's process and left the code in good shape." link_href="/case-studies/" link_text="View all"}}
      {{#get "posts" filter="tag:case-study" limit="3" include="tags"}}
        {{#if posts}}
          <div class="mrc-case-list">{{#foreach posts}}{{> "case-study-row"}}{{/foreach}}</div>
        {{/if}}
      {{/get}}
    </div>
  </section>

  {{! 7. Process }}
  <section class="mrc-section section-dark gh-outer" aria-labelledby="mrc-agency-process">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Process"
        heading_id="mrc-agency-process"
        heading="I work in your tools, not around them"
        intro="Non-disclosure first. Then GitLab, GitHub, Jira, or whatever you already run. No parallel process for your project manager to babysit."
      }}
      <div class="mrc-process-grid mrc-process-grid--numbered mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "process-step" title="Align" desc="We start with the ticket, the decisions already made, and who talks to the client — usually not me."}}
        {{> "process-step" title="Own" desc="I take a clear workstream: a defined build, embedded sprint capacity, an audit, or a rescue."}}
        {{> "process-step" title="Deliver" desc="Pull requests, risk notes, and standup updates in Atlantic Time. You see the work as it lands."}}
        {{> "process-step" title="Hand off" desc="Documentation, access, and next steps your team can run. Nothing hidden, nothing hostage."}}
      </div>
    </div>
  </section>

  {{! 8. Resources }}
  <section class="mrc-section section-surface gh-outer" aria-labelledby="mrc-agency-resources">
    <div class="gh-inner">
      {{> "section-header" layout="split" eyebrow="Resources" heading_id="mrc-agency-resources" heading="Useful reading for technical teams" intro="Practical guides and checklists you can use in the next sprint." link_href="/resources/" link_text="View all"}}
      {{#get "posts" filter="tag:-[case-study,glossary-term,hash-glossary-term]" limit="3" include="tags"}}
        {{#if posts}}
          <div class="mrc-post-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>
        {{/if}}
      {{/get}}
    </div>
  </section>

  {{! 9. Final CTA }}
  {{> "cta-section"
    headline="Let's see if we are a good fit."
    subtext="Overflow, a defined build, an audit, or a second opinion on architecture. Start with a conversation and we will figure out the rest."
    button_text="Contact"
    href="/contact/?audience=agencies-development-teams"
    secondary_href="/case-studies/"
    secondary_text="Work"
    ga_event="audience_primary_cta_click"
    ga_label="Contact"
    ga_audience="agencies_development_teams"
    ga_page_section="final_cta"
  }}

  <section class="mrc-audience-nav section-light gh-outer">
    <div class="mrc-audience-nav__inner gh-inner">
      {{> "audience-related-nav" omit="agencies-development-teams" audience="agencies_development_teams"}}
    </div>
  </section>
</main>
