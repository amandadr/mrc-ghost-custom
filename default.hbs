<!DOCTYPE html>
<html{{#match @custom.color_scheme "Dark"}} class="theme-dark"{{/match}}{{#match @custom.color_scheme "Light"}} class="theme-light"{{/match}} lang="{{@site.locale}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{! Preload only the first-paint faces. href must match font-faces (same asset helper URLs). }}
    <link rel="preload" href="{{asset "fonts/ibm-plex-sans/ibm-plex-sans-latin-400-normal.woff2"}}" as="font" type="font/woff2" crossorigin fetchpriority="high">
    <link rel="preload" href="{{asset "fonts/ibm-plex-serif/ibm-plex-serif-latin-600-normal.woff2"}}" as="font" type="font/woff2" crossorigin>
    {{> "font-faces"}}
    <title>{{#block "title"}}{{meta_title}}{{/block}}</title>
    {{#is "home"}}
        {{! First paint: header + hero + “What I do” / first service card; full theme loads async }}
        <link rel="stylesheet" href="{{asset "built/screen-home.css"}}">
        {{> "css-async-full"}}
    {{else}}
        {{#block "theme_css"}}
        <link rel="stylesheet" href="{{asset "built/screen.css"}}">
        {{/block}}
    {{/is}}

    {{#is "post"}}
        {{> "site-head"}}
    {{else}}
        {{#block "site_head"}}
            {{> "site-head" skip_cards=true}}
        {{/block}}
    {{/is}}
    {{{block "head"}}}
    {{> "ga4"}}

    {{! Favicon, og:image, twitter:image — only when Header logo is set (otherwise Ghost/defaults apply) }}
    {{#if @custom.header_logo}}
        <link rel="icon" type="image/png" href="{{@custom.header_logo}}">
        <meta property="og:image" content="{{@custom.header_logo}}">
        <meta name="twitter:image" content="{{@custom.header_logo}}">
    {{/if}}
</head>

<body class='{{body_class}}{{{block "body_class"}}} is-head-{{#match @custom.navigation_layout "Logo on the left"}}left-logo{{else match @custom.navigation_layout "Logo in the middle"}}middle-logo{{else}}stacked{{/match}}{{#match @custom.title_font "=" "Elegant serif"}} has-serif-title{{/match}}{{#match @custom.body_font "=" "Elegant serif"}} has-serif-body{{/match}}'>
<a class="mrc-skip-link" href="#main-content">Skip to content</a>
<div class="site">

    <header id="gh-head" class="gh-head mrc-head gh-outer">
        <div class="gh-head-inner gh-inner">
            <div class="gh-head-brand">
                <div class="gh-head-brand-wrapper">
                    <a class="gh-head-logo" href="{{@site.url}}">
                        {{#if @custom.header_logo}}
                            <img src="{{@custom.header_logo}}" alt="{{@site.title}}">
                            {{#if @custom.white_logo_for_dark_mode}}
                                <img src="{{img_url @custom.white_logo_for_dark_mode}}" alt="{{@site.title}}">
                            {{/if}}
                        {{else}}
                            <span class="mrc-logo-serif">Manny Roy</span> <span class="mrc-logo-sans">Consulting</span>
                        {{/if}}
                    </a>
                </div>
                <button
                    class="gh-burger"
                    type="button"
                    aria-label="Toggle menu"
                    aria-expanded="false"
                    aria-controls="gh-head-menu"
                ></button>
            </div>

            <nav id="gh-head-menu" class="gh-head-menu">
                {{navigation}}
            </nav>

            <div class="gh-head-actions mrc-head-actions-hidden">
                {{! Search and Subscribe removed per brand: compact header, nav only }}
            </div>
        </div>
    </header>

    {{#is "index"}}
        {{^is "home"}}
            {{> "cover"}}
            {{#if @custom.show_featured_posts}}
                {{> "featured-posts"}}
            {{/if}}
        {{/is}}
    {{/is}}

    <div class="site-content" id="main-content">
        {{{body}}}
    </div>

    {{> "footer"}}

</div>

{{! Full bundle (lightbox, reframe, PhotoSwipe, toc) for posts;
    other templates opt in with contentFor "scripts" + scripts-full partial.
    Marketing pages stay on main-lite to avoid PhotoSwipe weight. }}
{{#is "post"}}
    {{> "scripts-full"}}
{{else}}
    {{#block "scripts"}}
    <script src="{{asset "built/main-lite.min.js"}}" defer></script>
    {{/block}}
{{/is}}

{{ghost_foot}}

</body>
</html>