{{!< default}}
{{! About page — slug "about".
    Copy: assets/wireframes/raw copy/about.md + About PNGs.
    Keep PEI voice (two-column intro, Why This Work Exists, Outside of Work). Skip testimonials. }}
{{#contentFor "title"}}About | {{@site.title}}{{/contentFor}}
{{#contentFor "theme_css"}}
  <link rel="stylesheet" href="{{asset "built/screen-about.css"}}">
  {{> "css-async-full"}}
{{/contentFor}}
{{#contentFor "head"}}
  {{> "seo-meta"
    description="An independent technical partner for Atlantic Canadian businesses, community organizations, and creative agencies. Based in Souris, PEI."
    og_title="Hi, I'm Manny"
    og_description="An independent technical partner for Atlantic Canadian businesses, community organizations, and creative agencies."
    path="/about/"
  }}
{{/contentFor}}

<main class="site-main mrc-page mrc-page-about">
  {{> "hero"
    headline="Hi, I'm Manny"
    subtext="An independent technical partner for Atlantic Canadian businesses, community organizations, and creative agencies."
    primary_href="/contact/"
    primary_text="Contact"
    secondary_href="/services/"
    secondary_text="Services"
    ga_label_prefix="about_hero"
  }}

  {{> "two-column-section"
    section_class="surface"
    heading_id="mrc-about-intro-title"
    heading="Rooted in practicality."
    right_theme_headshot=true
    right_img_alt="Portrait of Manny Roy"
    p1="I'm Manny Roy (they/them), a web developer and technical consultant based in Souris, PEI."
    p2="Atlantic-knit, I've always felt at home around people who are self-reliant and skilled at making things work with what they have. That same resourcefulness shapes how I approach technology."
    p3="I help businesses and organizations untangle their digital systems. My background spans full-stack development, ecommerce, analytics, and automation, but the goal is always the same: build systems that actually make your day easier."
    p4="Whether I'm helping a local brewery streamline orders, training a non-profit's volunteers on a new CMS, or providing technical depth for a Halifax creative agency, I focus on clear communication and maintainable code."
  }}

  {{> "anchor-section"
    section_class="dark"
    heading_id="mrc-about-why-title"
    heading="Why This Work Exists"
    p1="I've always believed technology should make life easier—not create another job for someone already wearing ten hats."
    p2="Around PEI, I meet people running restaurants, studios, nonprofits, and family businesses. They are experts at what they do."
    p3="They shouldn't have to be web developers, IT managers, and database architects, too."
    accent_1="That's where I come in."
    divider=true
    after_1="Before tech, I worked in kitchens, taprooms, and wood shops. Those environments taught me that any system will break under pressure if it isn't built thoughtfully."
    accent_2="Good service is invisible when it works well. So are good systems."
  }}

  <section class="mrc-section section-light gh-outer" aria-labelledby="mrc-about-approach">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Approach"
        heading_id="mrc-about-approach"
        heading="Independent by choice, practical by nature"
        intro="My work is built on a simple idea: you should understand and control the systems that run your business."
      }}
      <div class="mrc-feature-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "feature-item" icon="document" title="Plain language" body="No jargon and no mystery. You will understand what I recommend and why it matters to your business."}}
        {{> "feature-item" icon="key" title="True ownership" body="I build websites you can update yourself. You won't need a developer on retainer to change a photo or fix a typo."}}
        {{> "feature-item" icon="accessibility" title="Accessible by default" body="Every site I build works for people with disabilities. This is not an add-on, it is the standard."}}
        {{> "feature-item" icon="gear" title="Architectural rigor" body="I plan before I build. The structure of your site should be scalable, secure, and logically sound."}}
      </div>
    </div>
  </section>

  <section class="mrc-section section-surface gh-outer" aria-labelledby="mrc-about-tech">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Toolkit"
        heading_id="mrc-about-tech"
        heading="Technologies I work with"
        intro="I don't force a single platform on everyone. I bring deep experience across modern stacks and legacy systems to choose the right tool for the job."
      }}
      {{> "tech-carousel"}}
    </div>
  </section>

  <section class="mrc-section section-light gh-outer" aria-labelledby="mrc-about-process">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Process"
        heading_id="mrc-about-process"
        heading="How we work together, step by step"
      }}
      <div class="mrc-process-grid mrc-process-grid--numbered mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "process-step" title="Discovery" desc="We start with a conversation about your business, your users, and what isn't working today. No technical talk, just honest questions."}}
        {{> "process-step" title="Recommendations" desc="I give you a clear plan with options and trade-offs. You decide what fits your budget, timeline, and goals."}}
        {{> "process-step" title="Implementation" desc="I build or fix what we agreed on. You see progress along the way, not a big reveal at the end."}}
        {{> "process-step" title="Knowledge transfer" desc="I show you how to use what we built. You leave with documentation, training, and a system you control."}}
      </div>
    </div>
  </section>

  {{> "cta-section"
    bg_class="section-dark"
    headline="Ready to untangle your digital systems?"
    subtext="Let's have a conversation about what's working, what's not, and what we can do about it."
    button_text="Get in touch"
    href="/contact/"
    ga_event="about_mid_cta_click"
    ga_label="Get in touch"
    ga_page_section="mid_cta"
  }}

  <section class="mrc-about-beyond section-surface gh-outer" aria-labelledby="mrc-about-beyond-title">
    <div class="mrc-about-prose-inner gh-inner">
      {{> "section-header"
        heading_id="mrc-about-beyond-title"
        heading="Outside of Work"
      }}
      <p class="mrc-about-prose-p">Home is a 150-year-old farmhouse lovingly known as 'The Dynamite House' in Bear River, PEI. Here, we tell the time by the sun and the seasons by the potato fields, and holistic thinking comes naturally to most.</p>
      <p class="mrc-about-prose-p">I spend my days outside of work tending to the homestead with my fiancee, exploring this beautiful island with our golden retrievers, and picking up new hobbies like they're lucky pennies.</p>
      <p class="mrc-about-prose-p">When I am not at the desk, I am outside with the dogs or fixing something in the farmhouse. The same patience I bring to a slow-cooked meal goes into the systems I build for you.</p>
      <p class="mrc-about-prose-p">Community, nature, and delicious food keep my head out of the web!</p>
    </div>
  </section>

  {{> "feed-resources"
    section_class="section-light"
    heading_id="mrc-about-resources"
    eyebrow="Resources"
    heading="Notes from the field"
    link_href="/resources/"
    link_text="View all"
    limit="3"
  }}

  {{> "cta-section"
    headline="Have a problem worth solving? Let us talk it through."
    subtext="No pressure and no jargon. Just a clear conversation about what your business needs to work better online."
    button_text="Contact"
    href="/contact/"
  }}
</main>
