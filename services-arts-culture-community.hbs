{{!< default}}
{{! Arts, Culture & Community — /services/arts-culture-community/
    Copy: assets/wireframes/raw copy/arts-culture-community.md }}
{{#contentFor "title"}}A Digital Home for Work That Matters | Manny Roy Consulting{{/contentFor}}
{{#contentFor "body_class"}} mrc-route-services-arts-culture-community{{/contentFor}}
{{#contentFor "head"}}
    <meta name="description" content="Clear, accessible websites for arts, culture, and community organizations. Built for small teams, diverse audiences, and ownership that lasts.">
    <meta property="og:title" content="A digital home for work that matters">
    <meta property="og:description" content="Your organization brings people together. A clear, accessible website makes sure everyone can find you, participate, and stay connected.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{@site.url}}/services/arts-culture-community/">
    <link rel="canonical" href="{{@site.url}}/services/arts-culture-community/">
{{/contentFor}}

<main class="site-main mrc-page mrc-page-audience mrc-page-audience--arts-culture-community">
  <div class="mrc-audience-breadcrumb-wrap section-light gh-outer">
    <div class="gh-inner">
      {{> "audience-breadcrumb" current_label="Arts, Culture & Community" path="/services/arts-culture-community/"}}
    </div>
  </div>

  {{! 1. Hero }}
  {{> "audience-hero"
    eyebrow="Arts, culture &amp; community"
    title="Spend less time chasing funding, and more time creating impact."
    lead="The funding landscape in Atlantic Canada is tougher than ever. You need a platform that drives independent revenue, proves your impact to grant juries, and is easy enough for your volunteers to run."
    primary_href="/case-studies/"
    primary_text="Work"
    secondary_href="/contact/?audience=arts-culture-community"
    secondary_text="Contact"
    ga_audience="arts_culture_community"
    ga_label_primary="Work"
    ga_label_secondary="Contact"
    fit_heading="The new reality for non-profits"
    fit_item1="Fierce competition for limited provincial grants"
    fit_item2="Relying on a rotating cast of volunteers"
    fit_item3="The need to diversify revenue through tickets and donors"
  }}

  {{! 2. Arts & Culture Today (Pain Points) }}
  <section class="mrc-audience-challenges section-surface gh-outer" aria-labelledby="mrc-arts-reality">
    <div class="mrc-audience-challenges__inner gh-inner">
      {{> "section-header"
        eyebrow="Arts & Culture Today"
        heading_id="mrc-arts-reality"
        heading="The funding is shrinking. The administrative work isn't."
        intro="You can't rely solely on government grants anymore. To keep your organization healthy, you need to eliminate digital friction that costs you donations, ticket sales, and time."
      }}
      <div class="mrc-audience-challenge-grid">
        {{> "audience-challenge" icon="document" title="The grant scramble" copy="Reporting takes weeks of manual data collection because your systems don't track the metrics that funders want to see."}}
        {{> "audience-challenge" icon="users" title="Volunteer turnover" copy="Only one person knows the website password, and updating the summer festival schedule takes a degree in computer science."}}
        {{> "audience-challenge" icon="smartphone" title="Lost donations" copy="Your current donation page is a clunky third-party link that confuses older donors and makes them give up."}}
        {{> "audience-challenge" icon="key" title="Ticketing fees" copy="Third-party event platforms are eating into your margins with high per-ticket fees."}}
        {{> "audience-challenge" icon="compass" title="Sponsor visibility" copy="Corporate sponsors are tightening their belts and expect professional, measurable digital visibility in return for their support."}}
        {{> "audience-challenge" icon="accessibility" title="Accessibility barriers" copy="Your digital presence doesn't meet the accessibility standards required to serve your entire community or qualify for certain funds."}}
      </div>
    </div>
  </section>

  {{! 3. What I do }}
  <section class="mrc-section section-light gh-outer" aria-labelledby="mrc-arts-services">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="What I do"
        heading_id="mrc-arts-services"
        heading="Digital tools your team can actually use"
      }}
      <div class="mrc-feature-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "feature-item" icon="chart" title="Analytics & Grant Reporting" body="Dashboards that automatically track the exact engagement metrics that provincial and federal funders require."}}
        {{> "feature-item" icon="calendar" title="Custom Ticketing Systems" body="Keep the fees in-house with integrated event registration and ticketing that you fully control."}}
        {{> "feature-item" icon="smartphone" title="Frictionless Donations" body="Custom donation flows that make it incredibly easy for locals to support you directly from their phones."}}
        {{> "feature-item" icon="accessibility" title="Accessible Design" body="Websites built to strict accessibility standards, ensuring you serve the whole community and meet funding requirements."}}
        {{> "feature-item" icon="plug" title="Sponsor Integration" body="Dedicated, high-visibility spaces to highlight corporate partners and prove the value of their investment."}}
        {{> "feature-item" icon="gear" title="Zero-Jargon CMS" body="Backends so simple that a summer student or weekend volunteer can learn to update the site in an hour."}}
      </div>
    </div>
  </section>

  {{! 4. Mid-page CTA }}
  {{> "cta-section"
    headline="Ready to diversify your revenue?"
    subtext="Let's look at your current setup and find ways to increase direct donations and reduce your administrative busywork."
    button_text="Get in touch"
    href="/contact/"
    ga_event="arts_mid_cta_click"
    ga_label="Get in touch"
    ga_page_section="mid_cta"
  }}

  {{! 5. Work }}
  {{> "feed-work"
    section_class="section-surface"
    heading_id="mrc-arts-work"
    eyebrow="Work"
    heading="Proof in the community"
    intro="Real projects for organizations that needed their digital presence to do more."
    link_href="/case-studies/"
    link_text="View all"
    limit="3"
  }}

  {{! 6. Process }}
  <section class="mrc-section section-dark gh-outer" aria-labelledby="mrc-arts-process">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Process"
        heading_id="mrc-arts-process"
        heading="Built for boards and volunteers"
        intro="We work at a pace that respects your capacity and your funding cycles."
      }}
      <div class="mrc-process-grid mrc-process-grid--numbered mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "process-step" title="Strategic alignment" desc="We start by aligning the project with your upcoming grant applications and revenue goals."}}
        {{> "process-step" title="Collaborative design" desc="We build consensus with your board and stakeholders without getting bogged down in endless meetings."}}
        {{> "process-step" title="Sustainable build" desc="I implement systems that don't require an expensive ongoing retainer to maintain."}}
        {{> "process-step" title="Volunteer handover" desc="Your team gets clear documentation and training so anyone can take the wheel."}}
      </div>
    </div>
  </section>

  {{! 7. Resources }}
  {{> "feed-resources"
    section_class="section-surface"
    heading_id="mrc-arts-resources"
    eyebrow="Guides"
    heading="Practical reading for non-profits"
    intro="Useful guides written for busy executive directors and board members."
    link_href="/resources/"
    link_text="View all"
    limit="3"
  }}

  {{! 8. Final CTA }}
  {{> "cta-section"
    headline="Let's build something your community will love"
    subtext="Start a conversation about your organization. Or explore the work first if you prefer."
    button_text="Contact"
    href="/contact/?audience=arts-culture-community"
    secondary_href="/case-studies/"
    secondary_text="Work"
    ga_event="audience_primary_cta_click"
    ga_label="Contact"
    ga_audience="arts_culture_community"
    ga_page_section="final_cta"
  }}

  <div class="mrc-audience-nav section-light gh-outer">
    <div class="mrc-audience-nav__inner gh-inner">
      {{> "audience-related-nav" omit="arts-culture-community" audience="arts_culture_community"}}
    </div>
  </div>
</main>
