{{!< default}}

<main class="site-main">

    {{#post}}
        {{> "content" width="narrow"}}
    {{/post}}

    {{#is "post"}}
        {{#post}}
            {{#if @custom.show_related_posts}}
                {{> "related-posts"}}
            {{/if}}

            {{> "comments"}}
            {{> "article-cta"}}
        {{/post}}
    {{/is}}

</main>