{{!< default}}
{{! Blog archive: used when collection is at /blog/ (see docs/routes-blog-archive.yaml) }}

<main class="site-main" id="blog-archive">
  <section class="mrc-section section-light gh-outer" aria-labelledby="blog-archive-title">
    <div class="gh-inner">
      <header class="mrc-section-header">
        <div class="mrc-section-header__text">
          <h1 id="blog-archive-title" class="mrc-section-header__title">Writing</h1>
          <p class="mrc-section-header__intro">Practical notes and guides from the field.</p>
        </div>
      </header>
      {{#if posts}}
        <div class="mrc-post-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
          {{#foreach posts}}
            {{> "post-card"}}
          {{/foreach}}
        </div>
      {{else}}
        <p class="mrc-section-header__intro">No posts yet.</p>
      {{/if}}
      {{#if pagination.pages}}
        {{pagination}}
      {{/if}}
    </div>
  </section>
</main>
