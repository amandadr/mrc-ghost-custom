{{!< default}}
{{! Public component library — live demos of theme partials + foundations.
    Mounted at /component-library/ via routes.yaml (no Ghost Page required).
    Keep out of primary nav; extend by adding a cl-frame block + TOC link. }}
{{#contentFor "title"}}Component library | Manny Roy Consulting{{/contentFor}}
{{#contentFor "body_class"}} mrc-route-component-library{{/contentFor}}
{{#contentFor "head"}}
  <meta name="description" content="Live component library for the Manny Roy Consulting theme — foundations, section components, and edge-case fixtures.">
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="{{@site.url}}/component-library/">
{{/contentFor}}

<main class="site-main mrc-page mrc-page-component-library">
  <header class="mrc-cl-intro section-light gh-outer">
    <div class="mrc-cl-intro__inner gh-inner">
      <h1 class="mrc-cl-intro__title">Component library</h1>
      <p class="mrc-cl-intro__lede">Live renders of theme partials and design foundations. Use this page to test short/long copy, missing pieces, and section rhythm before assembling pages.</p>
      <p class="mrc-cl-intro__meta">Source of truth: <code>partials/*.hbs</code> + tokens in <code>brand.css</code> / <code>typography.css</code>. Add demos with <code>cl-frame-start</code> / <code>cl-frame-end</code> and a TOC link.</p>
    </div>
  </header>

  <div class="mrc-cl-layout">
    {{> "component-library/cl-nav"}}

    <div class="mrc-cl-main">

      {{! ========== Foundations ========== }}
      {{> "component-library/cl-frame-start" id="cl-foundations" title="Foundations — colour, type, space" status="stable" notes="Token swatches from brand.css and typography.css. Not a partial — reference for visual QA."}}
        <div class="section-light mrc-cl-pad">
          <div class="mrc-cl-pad--narrow">
            <h3 class="mrc-section-heading">Colour</h3>
            <div class="mrc-cl-swatches" style="margin-bottom: var(--space-7);">
              <div class="mrc-cl-swatch"><div class="mrc-cl-swatch__chip" style="background: var(--mrc-bg);"></div><p class="mrc-cl-swatch__name">Cream</p><p class="mrc-cl-swatch__token">--mrc-bg</p></div>
              <div class="mrc-cl-swatch"><div class="mrc-cl-swatch__chip" style="background: var(--mrc-surface);"></div><p class="mrc-cl-swatch__name">Paper</p><p class="mrc-cl-swatch__token">--mrc-surface</p></div>
              <div class="mrc-cl-swatch"><div class="mrc-cl-swatch__chip" style="background: var(--mrc-text);"></div><p class="mrc-cl-swatch__name">Ink</p><p class="mrc-cl-swatch__token">--mrc-text</p></div>
              <div class="mrc-cl-swatch"><div class="mrc-cl-swatch__chip" style="background: var(--mrc-text-muted);"></div><p class="mrc-cl-swatch__name">Ink 2</p><p class="mrc-cl-swatch__token">--mrc-text-muted</p></div>
              <div class="mrc-cl-swatch"><div class="mrc-cl-swatch__chip" style="background: var(--mrc-mustard);"></div><p class="mrc-cl-swatch__name">Mustard</p><p class="mrc-cl-swatch__token">--mrc-mustard</p></div>
              <div class="mrc-cl-swatch"><div class="mrc-cl-swatch__chip" style="background: var(--mrc-olive);"></div><p class="mrc-cl-swatch__name">Olive</p><p class="mrc-cl-swatch__token">--mrc-olive</p></div>
              <div class="mrc-cl-swatch"><div class="mrc-cl-swatch__chip" style="background: var(--mrc-maroon);"></div><p class="mrc-cl-swatch__name">Maroon</p><p class="mrc-cl-swatch__token">--mrc-maroon</p></div>
            </div>

            <h3 class="mrc-section-heading">Type scale</h3>
            <div class="mrc-cl-type-sample"><p class="mrc-cl-type-sample__label">--mrc-h1-size</p><p class="mrc-hero-headline" style="margin:0;">Headline one</p></div>
            <div class="mrc-cl-type-sample"><p class="mrc-cl-type-sample__label">--mrc-h2-size</p><h2 class="mrc-section-heading" style="margin:0;">Headline two</h2></div>
            <div class="mrc-cl-type-sample"><p class="mrc-cl-type-sample__label">--mrc-h3-size / body / lede / small</p>
              <h3 style="margin:0 0 var(--space-2);">Headline three</h3>
              <p class="mrc-lede" style="margin:0 0 var(--space-2);">Lede size — slightly larger intro copy for sections.</p>
              <p style="margin:0 0 var(--space-2);">Body 16px / 1.72 — the default reading size across the site.</p>
              <p class="mrc-meta" style="margin:0;">Small / meta — captions and labels.</p>
            </div>

            <h3 class="mrc-section-heading">Spacing scale</h3>
            <div class="mrc-cl-space-bar">
              <div class="mrc-cl-space-bar__item"><div class="mrc-cl-space-bar__block" style="height: var(--space-1);"></div><span class="mrc-cl-space-bar__label">1</span></div>
              <div class="mrc-cl-space-bar__item"><div class="mrc-cl-space-bar__block" style="height: var(--space-2);"></div><span class="mrc-cl-space-bar__label">2</span></div>
              <div class="mrc-cl-space-bar__item"><div class="mrc-cl-space-bar__block" style="height: var(--space-3);"></div><span class="mrc-cl-space-bar__label">3</span></div>
              <div class="mrc-cl-space-bar__item"><div class="mrc-cl-space-bar__block" style="height: var(--space-4);"></div><span class="mrc-cl-space-bar__label">4</span></div>
              <div class="mrc-cl-space-bar__item"><div class="mrc-cl-space-bar__block" style="height: var(--space-5);"></div><span class="mrc-cl-space-bar__label">5</span></div>
              <div class="mrc-cl-space-bar__item"><div class="mrc-cl-space-bar__block" style="height: var(--space-6);"></div><span class="mrc-cl-space-bar__label">6</span></div>
              <div class="mrc-cl-space-bar__item"><div class="mrc-cl-space-bar__block" style="height: var(--space-7);"></div><span class="mrc-cl-space-bar__label">7</span></div>
              <div class="mrc-cl-space-bar__item"><div class="mrc-cl-space-bar__block" style="height: var(--space-8);"></div><span class="mrc-cl-space-bar__label">8</span></div>
              <div class="mrc-cl-space-bar__item"><div class="mrc-cl-space-bar__block" style="height: var(--space-9);"></div><span class="mrc-cl-space-bar__label">9</span></div>
            </div>
          </div>
        </div>

        <div class="section-surface mrc-cl-pad">
          <div class="mrc-cl-pad--narrow">
            <h3 class="mrc-section-heading">Section tones</h3>
            <p style="margin:0 0 var(--space-4); max-width: 60ch;">Rhythm classes: <code>.section-light</code> (cream), <code>.section-surface</code> (paper), <code>.section-dark</code> (olive), <code>.section-cta</code> (maroon).</p>
          </div>
        </div>
        <div class="section-dark mrc-cl-pad">
          <div class="mrc-cl-pad--narrow">
            <p style="margin:0; color: var(--mrc-surface); max-width: 60ch;">Olive / dark section — paper text, mustard accents.</p>
          </div>
        </div>
        <div class="section-cta mrc-cl-pad">
          <div class="mrc-cl-pad--narrow">
            <p style="margin:0; color: var(--mrc-surface); max-width: 60ch;">Maroon / CTA section tone.</p>
          </div>
        </div>
      {{> "component-library/cl-frame-end"}}

      {{! ========== Buttons ========== }}
      {{> "component-library/cl-frame-start" id="cl-buttons" title="Buttons" status="stable" notes="Primary / secondary on light and dark grounds. Focus rings should remain visible."}}
        <div class="section-light mrc-cl-pad">
          <div class="mrc-cluster mrc-cluster--m mrc-cl-pad--narrow" style="padding-inline:0;">
            <a href="#cl-buttons" class="button mrc-btn-primary">Primary</a>
            <a href="#cl-buttons" class="button mrc-btn-secondary">Secondary</a>
          </div>
        </div>
        {{> "cta-section" headline="CTA button (mustard on maroon)" subtext="`.mrc-cta-btn` is scoped to `.mrc-cta-section`." button_text="Get in touch" href="#cl-buttons"}}
      {{> "component-library/cl-frame-end"}}

      {{! ========== Composition ========== }}
      {{> "component-library/cl-frame-start" id="cl-composition" title="Composition primitives" status="stable" partial_name="(composition.css)" notes="Layout-only utilities from composition.css — stack, cluster, grid, split."}}
        <div class="section-surface mrc-cl-pad">
          <div class="mrc-cl-pad--narrow">
            <p class="mrc-cl-variant__label" style="background:transparent;color:var(--mrc-text-muted);padding-inline:0;">Stack — vertical rhythm</p>
            <div class="mrc-stack mrc-stack--l" style="margin-bottom: var(--space-7); max-width: 40ch;">
              <p style="margin:0; background: var(--mrc-bg); padding: var(--space-3);">Item A</p>
              <p style="margin:0; background: var(--mrc-bg); padding: var(--space-3);">Item B</p>
              <p style="margin:0; background: var(--mrc-bg); padding: var(--space-3);">Item C</p>
            </div>
            <p class="mrc-cl-variant__label" style="background:transparent;color:var(--mrc-text-muted);padding-inline:0;">Cluster — wrapping row</p>
            <div class="mrc-cluster mrc-cluster--m" style="margin-bottom: var(--space-7);">
              <span style="background: var(--mrc-bg); padding: var(--space-2) var(--space-3);">One</span>
              <span style="background: var(--mrc-bg); padding: var(--space-2) var(--space-3);">Two</span>
              <span style="background: var(--mrc-bg); padding: var(--space-2) var(--space-3);">Three</span>
              <span style="background: var(--mrc-bg); padding: var(--space-2) var(--space-3);">Four</span>
            </div>
            <p class="mrc-cl-variant__label" style="background:transparent;color:var(--mrc-text-muted);padding-inline:0;">Grid — auto-fit</p>
            <div class="mrc-grid mrc-grid--auto mrc-grid--gap-m">
              <div style="background: var(--mrc-bg); padding: var(--space-4); min-height: 4rem;">Cell</div>
              <div style="background: var(--mrc-bg); padding: var(--space-4); min-height: 4rem;">Cell</div>
              <div style="background: var(--mrc-bg); padding: var(--space-4); min-height: 4rem;">Cell</div>
            </div>
          </div>
        </div>
      {{> "component-library/cl-frame-end"}}

      {{! ========== Hero ========== }}
      {{> "component-library/cl-frame-start" id="cl-hero" title="Page hero" status="stable" partial_name="hero" notes="Used on home. Variants: default, long headline, CTA omitted."}}
        {{> "hero" heading_id="cl-hero-default" headline="Practical websites and digital systems for PEI businesses." subtext="Clear tools, honest advice, and work that stays manageable after the project ends." primary_text="Get in touch" secondary_text="Services" ga_label_prefix="cl_hero"}}
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">Long headline</p>
          {{> "hero" heading_id="cl-hero-long" headline="A very long heading that demonstrates what happens when somebody inevitably writes more words than the wireframe expected for this hero composition." subtext="Short supporting line." hide_secondary=true ga_label_prefix="cl_hero_long"}}
        </div>
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">No CTAs</p>
          {{> "hero" heading_id="cl-hero-empty" headline="Headline only — buttons missing." subtext="Use hide_cta when a page needs a quieter opening." hide_cta=true}}
        </div>
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">With media — becomes a left-aligned split</p>
          {{> "hero" heading_id="cl-hero-split" eyebrow="Tourism & hospitality" headline="A hero that carries a photo." subtext="Passing img or media_placeholder switches the hero from centred to split. Nothing else changes at the call site." media_placeholder=true primary_text="Get in touch" secondary_text="See the work" ga_label_prefix="cl_hero_split"}}
        </div>
      {{> "component-library/cl-frame-end"}}

      {{! ========== Feature grid ========== }}
      {{> "component-library/cl-frame-start" id="cl-feature" title="Feature grid" status="stable" partial_name="feature-item" notes="The most repeated wireframe shape. Icon is opt-in; columns come from .mrc-grid."}}
        <section class="mrc-section section-light gh-outer">
          <div class="gh-inner">
            {{> "section-header" heading="Three up, with icons"}}
            <div class="mrc-feature-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
              {{> "feature-item" icon="chart" title="Measure what matters" body="Analytics wired to the handful of numbers that actually change a decision."}}
              {{> "feature-item" icon="gear" title="Systems that keep running" body="Automation and integrations that survive staff turnover and busy seasons."}}
              {{> "feature-item" icon="accessibility" title="Accessible by default" body="Contrast, keyboard paths, and semantics checked before launch, not after a complaint."}}
            </div>
          </div>
        </section>
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">Text-only, four up, with links — the default rendering</p>
          <section class="mrc-section section-surface gh-outer">
            <div class="gh-inner">
              <div class="mrc-feature-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
                {{> "feature-item" title="Websites" body="Sites that load fast and are easy to update." href="#cl-feature"}}
                {{> "feature-item" title="Booking & forms" body="Fewer clicks between an interested visitor and a confirmed booking." href="#cl-feature" link_text="See how"}}
                {{> "feature-item" title="Content strategy" body="Deciding what to say before deciding where to put it." href="#cl-feature"}}
                {{> "feature-item" title="Training" body="Handover so the site does not become someone else's mystery." href="#cl-feature"}}
              </div>
            </div>
          </section>
        </div>
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">Pair — two large linked blocks (replaces a separate link-pair component)</p>
          <section class="mrc-section section-dark gh-outer">
            <div class="gh-inner">
              <div class="mrc-feature-grid mrc-feature-grid--pair mrc-grid mrc-grid--auto mrc-grid--gap-xl">
                {{> "feature-item" icon="compass" title="See the work" body="Case studies with the constraints, the decisions, and what happened afterwards." href="#cl-feature" link_text="Browse case studies"}}
                {{> "feature-item" icon="users" title="Not sure what you need?" body="Start with a conversation. No pitch deck, no obligation." href="#cl-feature" link_text="Get in touch"}}
              </div>
            </div>
          </section>
        </div>
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">Numbered — one item, and a long title with no body</p>
          <section class="mrc-section section-light gh-outer">
            <div class="gh-inner">
              <div class="mrc-feature-grid mrc-feature-grid--numbered mrc-grid mrc-grid--auto mrc-grid--gap-l">
                {{> "feature-item" title="A single numbered item that also happens to have an unreasonably long title"}}
              </div>
            </div>
          </section>
        </div>
      {{> "component-library/cl-frame-end"}}

      {{! ========== Tabs ========== }}
      {{> "component-library/cl-frame-start" id="cl-tabs" title="Tab selector" status="stable" partial_name="tab-panel" notes="Progressive enhancement: a stack of headed sections without JS, an ARIA tablist with it. Disable JavaScript to see the baseline."}}
        <section class="mrc-section section-light gh-outer">
          <div class="gh-inner">
            {{> "section-header" eyebrow="Who I help" heading="Find where you fit" intro="Each panel is a real section with its own id, so it stays linkable and printable whether or not the tabs load."}}
            <div class="mrc-tabs" data-mrc-tabs data-mrc-tabs-label="Audiences">
              <div class="mrc-tabs__panels">
                {{> "tab-panel" id="cl-tab-smb" label="Small business" title="Small & medium businesses" body="You need a site that earns its keep — quick to update, clear about what you sell, and cheap to run." href="#cl-tabs" link_text="Small & medium businesses"}}
                {{> "tab-panel" id="cl-tab-tourism" label="Tourism" title="Tourism & hospitality" body="Seasonal traffic, booking engines, and visitors deciding on a phone in a parking lot." href="#cl-tabs" link_text="Tourism & hospitality"}}
                {{> "tab-panel" id="cl-tab-arts" label="Arts & culture" title="Arts, culture & community" body="Small budgets, volunteer editors, and a calendar that has to be right." href="#cl-tabs" link_text="Arts, culture & community"}}
                {{> "tab-panel" id="cl-tab-orgs" label="Organizations" title="Organizations & institutions" body="Procurement, accessibility obligations, and more stakeholders than the timeline allows for." href="#cl-tabs" link_text="Organizations & institutions"}}
                {{> "tab-panel" id="cl-tab-agencies" label="Agencies" title="Agencies & development teams" body="Overflow capacity from someone who will not disappear mid-sprint." href="#cl-tabs" link_text="Agencies & development teams"}}
              </div>
            </div>
          </div>
        </section>
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">Two panels on olive — the minimum that still earns tabs</p>
          <section class="mrc-section section-dark gh-outer">
            <div class="gh-inner">
              <div class="mrc-tabs" data-mrc-tabs data-mrc-tabs-label="Engagement models">
                <div class="mrc-tabs__panels">
                  {{> "tab-panel" id="cl-tab-project" label="Project" title="A defined project" body="Fixed scope, a clear outcome, and a date it ends."}}
                  {{> "tab-panel" id="cl-tab-ongoing" label="Ongoing" title="Ongoing support" body="A standing arrangement for the things that need attention every month."}}
                </div>
              </div>
            </div>
          </section>
        </div>
      {{> "component-library/cl-frame-end"}}

      {{! ========== FAQ ========== }}
      {{> "component-library/cl-frame-start" id="cl-faq" title="FAQ accordion" status="stable" partial_name="faq-item" notes="Built on the details element: no JavaScript, keyboard accessible, and it prints open. Sharing a group name makes the set exclusive where supported."}}
        <section class="mrc-section section-light gh-outer">
          <div class="gh-inner">
            {{> "section-header" heading="Common questions"}}
            <div class="mrc-faq">
              {{> "faq-item" group="cl-faq-set" open=true question="How long does a project usually take?" answer="Most small business sites run four to eight weeks from kickoff to launch, and the biggest variable is how quickly content comes together — not the build."}}
              {{> "faq-item" group="cl-faq-set" question="Do you work with organizations outside PEI?" answer="Yes. Most of the work happens remotely regardless, though being on the Island makes in-person sessions easy for local clients."}}
              {{> "faq-item" group="cl-faq-set" question="What happens after launch — and who is responsible for keeping the thing running once the invoice is paid?" answer="You are, and that is deliberate. Handover includes documentation and a walkthrough so your team can make routine changes. Ongoing support is available if you would rather not."}}
              {{> "faq-item" group="cl-faq-set" question="Short one?" answer="Yes."}}
            </div>
          </div>
        </section>
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">On olive</p>
          <section class="mrc-section section-dark gh-outer">
            <div class="gh-inner">
              <div class="mrc-faq">
                {{> "faq-item" group="cl-faq-dark" question="Does the accordion work on a dark ground?" answer="Borders and the plus marker resolve from the section tone, so yes."}}
                {{> "faq-item" group="cl-faq-dark" question="Does it need JavaScript?" answer="No. It is a details element."}}
              </div>
            </div>
          </section>
        </div>
      {{> "component-library/cl-frame-end"}}

      {{! ========== Service card ========== }}
      {{> "component-library/cl-frame-start" id="cl-service-card" title="Service card" status="stable" partial_name="service-card" notes="Home pillars. Test short copy, long copy, and missing link."}}
        <section class="mrc-section section-surface mrc-pillars-section gh-outer">
          <div class="mrc-section-inner gh-inner">
            <h3 class="mrc-section-title">What I do (fixture)</h3>
            <div class="mrc-pillars mrc-grid mrc-grid--auto mrc-grid--gap-l">
              {{> "service-card" title="Short title" description="Brief description." link_url="#cl-service-card" link_text="Learn more"}}
              {{> "service-card" title="A longer service card title that wraps onto a second line under normal conditions" description="A longer description that stretches the card vertically so we can check alignment when one pillar has substantially more copy than its neighbours, including another sentence for good measure." link_url="#cl-service-card" link_text="Explore this longer path to the service detail"}}
              {{> "service-card" title="Missing link" description="Card with title and body only — no CTA."}}
            </div>
          </div>
        </section>
      {{> "component-library/cl-frame-end"}}

      {{! ========== Principle ========== }}
      {{> "component-library/cl-frame-start" id="cl-principle" title="Principle item" status="stable" partial_name="principle-item" notes="Home “How I work” on olive. One vs four items."}}
        <section class="mrc-section section-dark mrc-principles-section gh-outer">
          <div class="mrc-section-inner gh-inner">
            <h3 class="mrc-section-title">How I work (fixture)</h3>
            <div class="mrc-principles mrc-grid mrc-grid--auto mrc-grid--gap-l">
              {{> "principle-item" title="Practical" body="The right solution fits your business, your capacity, and the way you actually work."}}
              {{> "principle-item" title="Thoughtful" body="You will understand what is happening, why it matters, and what comes next."}}
              {{> "principle-item" title="Collaborative" body="We work through decisions together, with your knowledge of the business guiding the process."}}
              {{> "principle-item" title="Built to Last — with an awkwardly long principle title that should still read cleanly" body="Your website and tools should remain useful, manageable, and understandable after the project ends, even when the supporting sentence runs longer than usual for layout stress-testing."}}
            </div>
          </div>
        </section>
      {{> "component-library/cl-frame-end"}}

      {{! ========== CTA ========== }}
      {{> "component-library/cl-frame-start" id="cl-cta" title="CTA section" status="stable" partial_name="cta-section" notes="Final maroon band. Variants: primary only, + secondary, long headline."}}
        {{> "cta-section" headline="Let's make tech work for you" subtext="Tell me what isn't working." button_text="Get in touch" href="#cl-cta"}}
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">With secondary link</p>
          {{> "cta-section" headline="Ready when you are" subtext="Primary and secondary actions together." button_text="Get in touch" href="#cl-cta" secondary_href="#cl-cta" secondary_text="See related audiences"}}
        </div>
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">Long headline, no subtext</p>
          {{> "cta-section" headline="A very long CTA heading that demonstrates what happens when somebody inevitably writes more words than the wireframe expected for this closing band" button_text="Continue" href="#cl-cta"}}
        </div>
      {{> "component-library/cl-frame-end"}}

      {{! ========== Service section ========== }}
      {{> "component-library/cl-frame-start" id="cl-service-section" title="Service section" status="stable" partial_name="service-section" notes="Services page capability block. One include vs five."}}
        <section class="mrc-section section-light gh-outer">
          <div class="gh-inner mrc-stack mrc-stack--section">
            {{> "service-section" slug="cl-websites" title="Websites & web support" intro="Short intro for the capability." tagline="Clear sites that help people choose you." include1="New sites and rebuilds" include2="Content and IA cleanup" ideal="Owner-operated businesses refreshing an outdated site."}}
            {{> "service-section" slug="cl-systems" title="Digital systems with a longer title than usual for wrap testing" intro="A longer intro paragraph that explains the capability in more depth than a single sentence, so we can see how the block breathes when copy expands beyond the typical services-page length." tagline="Tools that reduce repetitive work." include1="Booking and forms" include2="Integrations" include3="Spreadsheets and light automation" include4="Repairs and cleanup" include5="Documentation handoff" ideal="Teams juggling too many disconnected tools and unclear ownership."}}
          </div>
        </section>
        <div class="mrc-cl-variant">
          <p class="mrc-cl-variant__label">With media — alternates sides on the right-aligned block</p>
          <section class="mrc-section section-surface gh-outer">
            <div class="gh-inner mrc-stack mrc-stack--section">
              {{> "service-section" slug="cl-media-a" title="Websites & web support" intro="Media sits to the right by default." tagline="Clear sites that help people choose you." include1="New sites and rebuilds" include2="Content and IA cleanup" ideal="Owner-operated businesses refreshing an outdated site." media_placeholder=true}}
