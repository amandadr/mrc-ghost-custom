{{!< default}}
{{! SEO: default.hbs auto-assigns meta description from custom_excerpt / excerpt
    when the Ghost meta_description field is empty. Custom post templates inherit the same. }}

<main class="site-main">

    {{#post}}
        {{#has tag="whitepaper"}}
            {{> "post-whitepaper"}}
        {{else}}
            {{#has tag="glossary-term"}}
                {{> "post-glossary-term"}}
            {{else}}
            {{#has tag="#glossary-term"}}
                {{> "post-glossary-term"}}
            {{else}}
                {{> "content" width="wide"}}
            {{/has}}
            {{/has}}
        {{/has}}
    {{/post}}

    {{#if @custom.show_related_posts}}
        {{#post}}
            {{#has tag="glossary-term"}}
            {{else}}
                {{#has tag="#glossary-term"}}
                {{else}}
                    {{> "related-posts"}}
                {{/has}}
            {{/has}}
        {{/post}}
    {{/if}}

    {{#post}}
        {{> "comments"}}
        {{#has tag="whitepaper,glossary-term,#glossary-term"}}
        {{else}}
            {{> "article-cta"}}
        {{/has}}
    {{/post}}

</main>
