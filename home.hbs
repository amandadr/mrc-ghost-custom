{{!< default}}
{{! Homepage: colurs.md rhythm Cream → Paper → Olive → Maroon (work section deferred) }}

<main class="site-main mrc-home">
  {{! 1. Cream }}
  <section class="mrc-hero section-light gh-outer" aria-labelledby="mrc-hero-heading">
    <div class="mrc-hero-inner gh-inner mrc-stack mrc-stack--l">
      <h1 id="mrc-hero-heading" class="mrc-hero-headline">{{@custom.hero_headline}}</h1>
      <p class="mrc-hero-subtext">{{@custom.hero_subtext}}</p>
      <div class="mrc-hero-cta mrc-cluster mrc-cluster--center">
        <a
          href="/contact/"
          class="button mrc-btn-primary"
          data-ga-event="cta_click"
          data-ga-category="engagement"
          data-ga-label="home_hero_get_in_touch"
        >Get in touch</a>
        <a
          href="/services/"
          class="button mrc-btn-secondary"
          data-ga-event="cta_click"
          data-ga-category="engagement"
          data-ga-label="home_hero_services"
        >Services</a>
      </div>
    </div>
  </section>

  {{! 2. Paper — What I do }}
  <section class="mrc-section section-surface mrc-pillars-section gh-outer" aria-labelledby="mrc-pillars-title">
    <div class="mrc-section-inner gh-inner">
      <h2 id="mrc-pillars-title" class="mrc-section-title">What I do</h2>
      <div class="mrc-pillars mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "service-card" title="Websites that help people choose you" description="Clear, useful websites that make it easier for customers to understand your business, find what they need, and take the next step." link_url="https://mannyroy.com" link_text="Explore websites and web support"}}
        {{> "service-card" title="Digital tools that make work easier" description="Booking systems, forms, spreadsheets, integrations, and practical improvements that reduce repetitive work and everyday frustration." link_url="https://mannyroy.com" link_text="Explore digital systems and technical support"}}
        {{> "service-card" title="Clear advice when things feel complicated" description="Audits, planning, troubleshooting, and plain-language guidance to help you understand what is working, what is not, and what to do next." link_url="https://mannyroy.com" link_text="Explore consulting and strategy"}}
      </div>
    </div>
  </section>

  {{! 3. Olive — How I work }}
  <section class="mrc-section section-dark mrc-principles-section gh-outer" aria-labelledby="mrc-principles-title">
    <div class="mrc-section-inner gh-inner">
      <h2 id="mrc-principles-title" class="mrc-section-title">How I work</h2>
      <div class="mrc-principles mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "principle-item" title="Practical" body="The right solution fits your business, your capacity, and the way you actually work."}}
        {{> "principle-item" title="Thoughtful" body="You will understand what is happening, why it matters, and what comes next."}}
        {{> "principle-item" title="Collaborative" body="We work through decisions together, with your knowledge of the business guiding the process."}}
        {{> "principle-item" title="Built to Last" body="Your website and tools should remain useful, manageable, and understandable after the project ends."}}
      </div>
    </div>
  </section>

  {{! 4. Maroon — Final CTA }}
  {{> "cta-section" headline="Let's make tech work for you" subtext="Tell me what isn't working, what you're trying to improve, or what you've been putting off. We’ll figure out your next step together." button_text="Get in touch"}}
</main>
