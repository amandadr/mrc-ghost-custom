{{!< default}}
{{! Services & Capabilities — Ghost Page slug "services".
    Copy: assets/wireframes/raw copy/services-capabilities.md }}
{{#contentFor "title"}}Services | {{@site.title}}{{/contentFor}}
{{#contentFor "theme_css"}}
  {{> "screen-services-inline"}}
  {{> "css-async-idle"}}
{{/contentFor}}
{{#contentFor "head"}}
  {{> "seo-meta"
    description="Websites, systems, and strategy for Atlantic Canadian businesses and organizations. Practical help with rebuilds, booking flows, accessibility, and extra engineering capacity."
    og_title="Solutions for your digital growing pains"
    og_description="You don't need to know the technical name for your problem. We'll figure it out together."
    path="/services/"
  }}
{{/contentFor}}

<main class="site-main mrc-page mrc-page-services">
  {{! 1. Hero }}
  {{> "hero"
    eyebrow="Services"
    headline="Solutions for your digital growing pains"
    subtext="You don't need to know the technical name for your problem. Whether you need a complete rebuild, a broken booking flow fixed, or extra engineering capacity, we'll figure it out together."
    primary_href="/contact/"
    primary_text="Contact"
    secondary_href="/case-studies/"
    secondary_text="Work"
    ga_label_prefix="services_hero"
  }}

  {{! 2. Core Services — each service-section is its own labelled landmark }}
  <div class="mrc-section section-surface gh-outer">
    <div class="gh-inner mrc-stack mrc-stack--section">
      {{> "service-section"
        slug="websites-platforms"
        title="Websites & Platforms"
        tagline="Digital homes that actually work."
        intro="Fast, accessible, and easy to update. I build sites that look great and perform even better, without leaving you dependent on a developer for every typo."
        include1="Custom development (React, Next.js, Ghost)"
        include2="Technical SEO & performance optimization"
        include3="Accessibility (WCAG) compliance"
        include4="CMS training & handover"
        ideal="Businesses outgrowing their current site, or agencies needing front-end capacity."
      }}

      {{> "service-section"
        align="right"
        slug="systems-automation"
        title="Systems & Automation"
        tagline="Let the machines do the boring work."
        intro="If you're copying and pasting data between five different tools, you're losing time and money. I connect your software so your operations run smoothly and your team can focus on real work."
        include1="Booking & reservation flows"
        include2="API integrations (Zapier, Make, custom)"
        include3="Analytics & reporting dashboards"
        include4="Legacy system modernization"
        ideal="Tourism operators, non-profits, and teams drowning in manual admin work."
      }}

      {{> "service-section"
        slug="strategy-advisory"
        title="Strategy & Advisory"
        tagline="Know what you have before you build."
        intro="Most businesses don't need a complete rebuild—they need to fix what's broken. I provide honest audits and clear roadmaps so you can make decisions without the pressure of a sales pitch."
        include1="Technical & SEO audits"
        include2="Platform architecture & vendor selection"
        include3="Accessibility reviews"
        include4="Agency technical partnership"
        ideal="Board members, owners, and PMs who need a clear, unbiased technical plan."
      }}
    </div>
  </div>

  {{! 3. Audiences }}
  <section class="mrc-section section-light gh-outer" aria-labelledby="mrc-svc-audiences" id="audiences">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Audiences"
        heading_id="mrc-svc-audiences"
        heading="This is what I can do for you"
        intro="Every sector has its own digital realities. Find your space below to see how we can tackle your specific technical challenges."
      }}
      <div class="mrc-tabs" data-mrc-tabs data-mrc-tabs-label="Audiences">
        <div class="mrc-tabs__panels">
          {{> "tab-panel" id="svc-tab-smb" label="Small businesses" title="For small businesses" body="Get a website that actively sells for you, connect your scattered tools, and take back control of your digital presence without needing an IT department." href="/services/small-businesses/" link_text="Small business services"}}
          {{> "tab-panel" id="svc-tab-tourism" label="Tourism" title="Tourism and hospitality" body="Fix broken booking flows, integrate your property management systems smoothly, and capture more reservations during your busiest seasons." href="/services/tourism-hospitality/" link_text="Tourism and hospitality services"}}
          {{> "tab-panel" id="svc-tab-arts" label="Arts & community" title="Arts and community" body="Simplify event ticketing, organize donor data, and build an accessible platform that your volunteers can confidently update." href="/services/arts-culture-community/" link_text="Arts and community services"}}
          {{> "tab-panel" id="svc-tab-orgs" label="Organizations" title="Organizations and institutions" body="Meet strict accessibility standards, modernize legacy infrastructure securely, and establish clear digital governance that outlasts any single employee." href="/services/organizations-institutions/" link_text="Organizations and institutions"}}
          {{> "tab-panel" id="svc-tab-agencies" label="Agencies" title="Agencies and development teams" body="Clear your backlog with reliable engineering capacity, rigorous QA, and architectural consulting that slots seamlessly into your existing sprints." href="/services/agencies-development-teams/" link_text="Agencies and development teams"}}
        </div>
      </div>
    </div>
  </section>

  {{! 4. Toolkit }}
  <section class="mrc-section section-surface gh-outer" aria-labelledby="mrc-svc-tech">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Toolkit"
        heading_id="mrc-svc-tech"
        heading="Technologies I work with"
      }}
      {{> "tech-carousel"}}
    </div>
  </section>

  {{! 5. Mid-page CTA }}
  {{> "cta-section"
    headline="Ready to fix what's broken?"
    subtext="If you're tired of wrestling with your digital tools, let's talk about a practical way forward."
    button_text="Get in touch"
    href="/contact/"
    ga_event="services_mid_cta_click"
    ga_label="Get in touch"
    ga_page_section="mid_cta"
  }}

  {{! 6. Process }}
  <section class="mrc-section section-light gh-outer" aria-labelledby="mrc-svc-process">
    <div class="gh-inner">
      {{> "section-header"
        heading_id="mrc-svc-process"
        heading="How the work unfolds"
      }}
      <div class="mrc-process-grid mrc-process-grid--numbered mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "process-step" title="Listen first" desc="We start with your goals, your frustrations, and how your business operates now."}}
        {{> "process-step" title="Assess honestly" desc="I look at what exists, what works, and what is holding you back."}}
        {{> "process-step" title="Build together" desc="We implement in clear steps, with you involved and informed throughout."}}
        {{> "process-step" title="Hand over control" desc="You get documentation, training, and a system you can run yourself."}}
      </div>
    </div>
  </section>

  {{! 7. Work }}
  {{> "feed-work"
    section_class="section-surface"
    heading_id="mrc-svc-work"
    eyebrow="Work"
    heading="Proof in the work"
    link_href="/case-studies/"
    link_text="View all"
    limit="3"
  }}

  {{! 8. Resources }}
  {{> "feed-resources"
    section_class="section-light"
    heading_id="mrc-svc-resources"
    eyebrow="Resources"
    heading="Essential resources"
    link_href="/resources/"
    link_text="View all"
    limit="3"
  }}

  {{! 9. Final CTA }}
  {{> "cta-section"
    headline="Not sure which service fits your situation?"
    subtext="Start with a conversation. We will look at what is working, what is not, and what comes next."
    button_text="Contact"
    href="/contact/"
    secondary_href="/case-studies/"
    secondary_text="Work"
  }}
</main>
