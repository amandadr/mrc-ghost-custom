{{!< default}}
{{! Services page — slug "services". Section layout with copy in template (editing = edit this file). }}

<main class="site-main mrc-page mrc-page-services">
  {{! 1. Hero — Cream }}
  <section class="mrc-services-hero section-light gh-outer">
    <div class="mrc-services-hero-inner gh-inner mrc-stack mrc-stack--m">
      <h1 class="mrc-services-hero-title">Technical systems built to last.</h1>
      <p class="mrc-services-hero-subtext">Technology should save time, not create more work. I help businesses build websites, systems, and workflows that support the people using them.</p>
    </div>
    <div class="mrc-services-hero-divider"></div>
  </section>

  {{! 2. Services Overview — Paper }}
  <section class="mrc-services-overview section-surface gh-outer" aria-labelledby="mrc-services-overview-title">
    <div class="mrc-services-overview-inner gh-inner">
      {{> "service-section" slug="systems" title="Systems & Technical Strategy" intro="When systems grow faster than the structure supporting them, complexity compounds. I help teams clarify their architecture, untangle infrastructure decisions, and design systems that scale intentionally." include1="API design & integration strategy" include2="Infrastructure and tech stack evaluation" include3="Data architecture planning" include4="Performance and analytics audits" ideal="Teams preparing to scale, migrate, or reduce technical debt."}}

      {{> "service-section" slug="software" align="right" title="Custom Software & Web Applications" tagline="Build once. Maintain well." intro="I design and develop custom software and web applications that prioritize stability, clarity, and long-term maintainability over quick patches." include1="Full-stack web application development" include2="Internal tooling" include3="API integrations" include4="E-commerce and system modernization" ideal="Organizations outgrowing plugin stacks or needing custom operational tools."}}

      {{> "service-section" slug="automation" title="Automation & Applied AI" intro="Practical AI and automation that integrate into real workflows — not prototype theatre." include1="Workflow automation" include2="Data pipelines & reporting systems" include3="Applied AI tooling" include4="AI adoption workshops & training" ideal="Teams ready to implement AI responsibly and sustainably."}}
    </div>
  </section>

  {{! 3. Common projects — Cream, paper cards }}
  <section class="mrc-common-projects section-light gh-outer" aria-labelledby="mrc-common-projects-title">
    <div class="mrc-common-projects-inner gh-inner">
      <h2 id="mrc-common-projects-title" class="mrc-common-projects-title">Common projects</h2>
      <p class="mrc-common-projects-intro">You don’t need to know which service category your project fits into. These are some of the practical ways I help businesses improve how they work online.</p>
      <div class="mrc-common-projects-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "common-project-card" title="Websites and online presence" item1="New websites and rebuilds" item2="Seasonal content updates" item3="Online menus and visitor information" item4="Accessibility and performance improvements" item5="Hosting, domains, and website rescue"}}
        {{> "common-project-card" title="Bookings, sales, and customer experience" item1="Booking and reservation improvements" item2="Ecommerce and online ordering" item3="Takeout and delivery integrations" item4="Forms and inquiry workflows" item5="Customer journeys that are easier to follow"}}
        {{> "common-project-card" title="Day-to-day digital operations" item1="Connecting tools that do not work well together" item2="Automating repetitive tasks" item3="Reporting and dashboards" item4="Staff documentation and training" item5="Simplifying confusing processes"}}
        {{> "common-project-card" title="Advice, audits, and workshops" item1="Website and systems audits" item2="Technical planning and prioritization" item3="SEO and analytics reviews" item4="Practical AI adoption" item5="Team workshops and one-on-one guidance"}}
      </div>
      <div class="mrc-common-projects-prompt">
        <p class="mrc-common-projects-prompt-lead"><strong>Not sure where your project fits?</strong></p>
        <p class="mrc-common-projects-prompt-body">Start with what is frustrating you or taking more time than it should.</p>
        <a href="/contact/" class="mrc-common-projects-prompt-link">Tell me what’s going on →</a>
      </div>
    </div>
  </section>

  {{! 4. Ways we can work together — Olive }}
  <section class="mrc-engagement section-dark gh-outer" aria-labelledby="mrc-engagement-title">
    <div class="mrc-engagement-inner gh-inner">
      <h2 id="mrc-engagement-title" class="mrc-engagement-title">Ways we can work together</h2>
      <div class="mrc-engagement-ways">
        {{> "engagement-way" title="One-time projects" desc="Focused work with a clear scope, timeline, and outcome."}}
        {{> "engagement-way" title="Advice and planning" desc="Audits, strategy, troubleshooting, and help deciding what comes next."}}
        {{> "engagement-way" title="Implementation support" desc="Hands-on help building, fixing, connecting, or improving your systems."}}
        {{> "engagement-way" title="Ongoing support" desc="Regular updates, maintenance, guidance, and technical help when needed."}}
      </div>
    </div>
  </section>

  {{! 5. Process — Cream }}
  <section class="mrc-process section-light gh-outer" aria-labelledby="mrc-process-title">
    <div class="mrc-process-inner gh-inner">
      <h2 id="mrc-process-title" class="mrc-process-title">The process</h2>
      <div class="mrc-process-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "process-step" title="Discovery" desc="Understand constraints, goals, and existing systems."}}
        {{> "process-step" title="Design" desc="Architect solutions grounded in sustainability and data."}}
        {{> "process-step" title="Build" desc="Implement with clarity and documentation."}}
        {{> "process-step" title="Evaluate" desc="Measure impact and refine intentionally."}}
      </div>
    </div>
  </section>

  {{! 6. CTA — Maroon }}
  {{> "cta-section" headline="Let's build something sustainable." subtext="If you're navigating complexity or planning what's next, I'm happy to talk." button_text="Get in touch"}}
</main>
