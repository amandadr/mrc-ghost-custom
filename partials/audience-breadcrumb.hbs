{{! Visible breadcrumbs + BreadcrumbList JSON-LD }}
{{! Required: current_label, path (e.g. /services/small-businesses/) }}
<nav class="mrc-audience-breadcrumb" aria-label="Breadcrumb">
  <ol class="mrc-audience-breadcrumb__list">
    <li class="mrc-audience-breadcrumb__item">
      <a href="{{@site.url}}/">Home</a>
    </li>
    <li class="mrc-audience-breadcrumb__item">
      <a href="{{@site.url}}/services/">Services</a>
    </li>
    <li class="mrc-audience-breadcrumb__item" aria-current="page">
      <span>{{current_label}}</span>
    </li>
  </ol>
</nav>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{@site.url}}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "{{@site.url}}/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{current_label}}",
      "item": "{{@site.url}}{{path}}"
    }
  ]
}
</script>
