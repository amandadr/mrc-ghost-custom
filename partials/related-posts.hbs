{{!-- Keep Reading — full-width olive band between the author sign-off and the article CTA.
    Include this partial from inside a post block so id/tags resolve. --}}
<section class="related-wrapper section-dark gh-outer">
    <div class="related-inner gh-inner">
        <h2 class="related-title">Keep Reading</h2>
        <div class="related-feed">
            {{#get "posts" limit="5" filter="id:-{{id}}" include="tags"}}
                {{#foreach posts}}
                    {{> "loop"}}
                {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>
