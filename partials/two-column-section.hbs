{{! Two-column section: left = heading + body (max 60ch); right = optional portrait/badge or placeholder for 60/40. }}
<section class="mrc-two-col section-{{section_class}} gh-outer" {{#if section_id}}id="{{section_id}}"{{/if}} aria-labelledby="{{heading_id}}">
  <div class="mrc-two-col-inner gh-inner{{#if right_img}} mrc-two-col-has-right mrc-split mrc-split--60-40{{else if right_theme_headshot}} mrc-two-col-has-right mrc-split mrc-split--60-40{{else if right_placeholder}} mrc-two-col-has-right mrc-split mrc-split--60-40{{/if}}">
    <div class="mrc-two-col-left">
      <h2 id="{{heading_id}}" class="mrc-two-col-title">{{heading}}</h2>
      {{#if p1}}<p class="mrc-two-col-p">{{p1}}</p>{{/if}}
      {{#if p2}}<p class="mrc-two-col-p">{{p2}}</p>{{/if}}
      {{#if p3}}<p class="mrc-two-col-p">{{p3}}</p>{{/if}}
      {{#if p4}}<p class="mrc-two-col-p">{{p4}}</p>{{/if}}
      {{#if p5}}<p class="mrc-two-col-p">{{p5}}</p>{{/if}}
    </div>
    {{! Right slot is a portrait slot by convention, so it always uses the round shape. }}
    {{#if right_img}}
    <div class="mrc-two-col-right">
      {{> "media-frame" img=right_img img_alt=right_img_alt shape="round"}}
    </div>
    {{else if right_theme_headshot}}
    <div class="mrc-two-col-right">
      {{> "media-frame" theme_headshot=true img_alt=right_img_alt shape="round"}}
    </div>
    {{else if right_placeholder}}
    <div class="mrc-two-col-right">
      {{> "media-frame" placeholder=true shape="round"}}
    </div>
    {{/if}}
  </div>
</section>
