{{!-- Shared case-study feed band.
      Params: section_class (default section-surface), heading_id, heading, intro,
              eyebrow, limit (use "1" or "3"), link_href, link_text --}}
<section class="mrc-section {{#if section_class}}{{section_class}}{{else}}section-surface{{/if}} gh-outer" aria-labelledby="{{heading_id}}">
  <div class="gh-inner">
    {{> "section-header"
      layout="split"
      eyebrow=eyebrow
      heading_id=heading_id
      heading=heading
      intro=intro
      link_href=link_href
      link_text=link_text
    }}
    {{#match limit "=" "1"}}
      {{#get "posts" filter="tag:case-study" limit="1" include="tags"}}
        {{#if posts}}
          <div class="mrc-case-list">{{#foreach posts}}{{> "case-study-row"}}{{/foreach}}</div>
        {{/if}}
      {{/get}}
    {{else}}
      {{#get "posts" filter="tag:case-study" limit="3" include="tags"}}
        {{#if posts}}
          <div class="mrc-case-list">{{#foreach posts}}{{> "case-study-row"}}{{/foreach}}</div>
        {{/if}}
      {{/get}}
    {{/match}}
  </div>
</section>
