<article class="single single--case-study {{post_class}}">
  <header class="single-header gh-canvas">
    <h1 class="single-title">{{title}}</h1>
    {{#if custom_excerpt}}
      <div class="single-excerpt">{{custom_excerpt}}</div>
    {{/if}}

    <div class="single-meta">
      {{#primary_tag}}
        <span class="single-meta-item single-meta-tag">
          <a class="post-tag post-tag-{{slug}}" href="{{url}}">{{name}}</a>
        </span>
      {{/primary_tag}}
      <span class="single-meta-item single-meta-date">
        <time datetime="{{date format="YYYY-MM-DD"}}">{{date published_at format="DD MMM YYYY"}}</time>
      </span>
      {{#if reading_time}}
        <span class="single-meta-item single-meta-length">{{reading_time}}</span>
      {{/if}}
    </div>

    {{#if feature_image}}
    {{#unless no_image}}
      <figure class="single-media kg-width-wide">
        <div class="u-placeholder horizontal">
          <img
            class="u-object-fit"
            srcset="{{> srcset}}"
            sizes="(min-width: 1200px) 920px, 92vw"
            src="{{img_url feature_image size="l"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
          >
        </div>

        {{#if feature_image_caption}}
          <figcaption>{{feature_image_caption}}</figcaption>
        {{/if}}
      </figure>
    {{/unless}}
    {{/if}}
  </header>

  <div class="mrc-split mrc-split--40-60 gh-canvas">
    {{> "post-toc"}}
    {{!-- Render post content normally; JS upgrades the first PDF link into an embedded viewer. --}}
    <div class="gh-content" data-pdf-viewer>
      {{content}}
    </div>
  </div>
</article>
