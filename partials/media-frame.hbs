{{!-- Media frame — the theme-wide photo ⇄ text-only switch.

      The site is text-first: with no `img`, this renders nothing and the calling
      component collapses to a single column. `placeholder` exists so the component
      library can show the photo slot; it should never appear on a live page.

      Params:
        img             image URL — omit for the text-only rendering
        theme_headshot  true → @custom.about_headshot if set, else assets/images/headshot.webp
        img_alt         alt text; omitted means decorative (alt="" + aria-hidden)
        shape           "round" | "portrait" | "landscape" | "square"
        placeholder     true → bordered empty slot (component library only) --}}
{{#if img}}
  <figure class="mrc-media-frame{{#if shape}} mrc-media-frame--{{shape}}{{/if}}">
    <img
      class="mrc-media-frame__img"
      src="{{img}}"
      alt="{{#if img_alt}}{{img_alt}}{{/if}}"
      {{#unless img_alt}}aria-hidden="true"{{/unless}}
      loading="lazy"
      decoding="async"
    >
  </figure>
{{else if theme_headshot}}
  <figure class="mrc-media-frame{{#if shape}} mrc-media-frame--{{shape}}{{/if}}">
    {{#if @custom.about_headshot}}
      <img
        class="mrc-media-frame__img"
        src="{{img_url @custom.about_headshot size="m"}}"
        alt="{{#if img_alt}}{{img_alt}}{{/if}}"
        {{#unless img_alt}}aria-hidden="true"{{/unless}}
        loading="lazy"
        decoding="async"
      >
    {{else}}
    <picture>
      <source srcset="{{asset "images/headshot.webp"}}" type="image/webp">
      <img
        class="mrc-media-frame__img"
        src="{{asset "images/headshot.jpeg"}}"
        alt="{{#if img_alt}}{{img_alt}}{{/if}}"
        {{#unless img_alt}}aria-hidden="true"{{/unless}}
        width="640"
        height="640"
        loading="lazy"
        decoding="async"
      >
    </picture>
    {{/if}}
  </figure>
{{else if placeholder}}
  <div class="mrc-media-frame mrc-media-frame--placeholder{{#if shape}} mrc-media-frame--{{shape}}{{/if}}" aria-hidden="true">
    <span class="mrc-media-frame__note">Photo slot</span>
  </div>
{{/if}}
