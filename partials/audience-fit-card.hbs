{{! “Good fit for” supporting card — audience hero }}
<aside class="mrc-audience-fit-card" aria-labelledby="{{#if heading_id}}{{heading_id}}{{else}}mrc-audience-fit-heading{{/if}}">
  <h2 id="{{#if heading_id}}{{heading_id}}{{else}}mrc-audience-fit-heading{{/if}}" class="mrc-audience-fit-card__heading">{{#if heading}}{{heading}}{{else}}Good fit for{{/if}}</h2>
  <ul class="mrc-audience-fit-card__list">
    {{#if item1}}<li>{{item1}}</li>{{/if}}
    {{#if item2}}<li>{{item2}}</li>{{/if}}
    {{#if item3}}<li>{{item3}}</li>{{/if}}
    {{#if item4}}<li>{{item4}}</li>{{/if}}
    {{#if item5}}<li>{{item5}}</li>{{/if}}
  </ul>
</aside>
