<article class="single {{post_class}}">

    {{#match @page.show_title_and_feature_image}}
        <header class="single-header gh-canvas">
            {{#is "post"}}
            <div class="single-meta">
                <span class="single-meta-item single-meta-date">
                    <time datetime="{{date format="YYYY-MM-DD"}}">
                        {{date published_at format="DD MMM YYYY"}}
                    </time>
                </span>
                {{#if reading_time}}
                    <span class="single-meta-item single-meta-length">
                        {{reading_time}}
                    </span>
                {{/if}}
                {{#primary_tag}}
                    <span class="single-meta-item single-meta-tag">
                        <a class="post-tag post-tag-{{slug}}" href="{{url}}">
                            {{name}}
                        </a>
                    </span>
                {{/primary_tag}}
            </div>
            {{/is}}

            <h1 class="single-title">{{title}}</h1>

            {{#if custom_excerpt}}
                <div class="single-excerpt">
                    {{custom_excerpt}}
                </div>
            {{/if}}

            {{#if feature_image}}
            {{#unless no_image}}
                <figure class="single-media kg-width-{{width}}">
                    <div class="u-placeholder horizontal">
                        <img
                            class="u-object-fit"
                            srcset="{{> srcset}}"
                            sizes="(min-width: 768px) min(92vw, 52rem), 92vw"
                            src="{{img_url feature_image size="l"}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        >
                    </div>

                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/unless}}
            {{/if}}
        </header>
    {{/match}}

    {{#is "post"}}
    <div class="single-body gh-canvas">
        {{> "post-toc" source=".single-content"}}
        <div class="single-content gh-content" data-pdf-viewer>
            {{content}}
        </div>
    </div>
    {{else}}
    <div class="single-content gh-content gh-canvas">
        {{content}}
    </div>
    {{/is}}

    {{#is "post"}}
    <div class="gh-canvas">
    <footer class="single-footer">

        <div class="single-footer-left">
        {{#prev_post}}
            <div class="navigation navigation-previous">
                <a class="navigation-link" href="{{url}}" aria-label="Previous post">
                    {{> "icons/arrow-left"}}
                </a>
            </div>
        {{/prev_post}}
        </div>

        <div class="single-footer-middle">
        {{#if @custom.show_author}}
            <div class="author-signoff">
                {{#foreach authors}}
                <div class="author-signoff__item">
                    <div class="author-signoff__photo u-placeholder square">
                        <img
                            class="author-image u-object-fit"
                            src="{{#if profile_image}}{{img_url profile_image size="xs"}}{{else}}{{asset "images/headshot.webp"}}{{/if}}"
                            alt=""
                            width="64"
                            height="64"
                            loading="lazy"
                        >
                    </div>
                    <div class="author-signoff__copy">
                        <p class="author-signoff__byline">Written by <span class="author-signoff__name">{{name}}</span></p>
                        <a class="author-signoff__about" href="{{url}}">
                            About <span class="author-signoff__first-name">{{name}}</span> →
                        </a>
                    </div>
                </div>
                {{/foreach}}
            </div>
            <script>
            (function () {
                document.querySelectorAll('.author-signoff__first-name').forEach(function (el) {
                    var first = (el.textContent || '').trim().split(/\s+/)[0];
                    if (first) {
                        el.textContent = first;
                    }
                });
            })();
            </script>
        {{/if}}
        </div>

        <div class="single-footer-right">
        {{#next_post}}
            <div class="navigation navigation-next">
                <a class="navigation-link" href="{{url}}" aria-label="Next post">
                    {{> "icons/arrow-right"}}
                </a>
            </div>
        {{/next_post}}
        </div>

    </footer>
    </div>
    {{/is}}

</article>
