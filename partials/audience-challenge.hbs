{{! Recognizable-problem card — lighter than project cards }}
<article class="mrc-audience-challenge">
  {{#if icon}}
    <span class="mrc-audience-challenge__marker mrc-audience-challenge__marker--icon" aria-hidden="true">{{> "icon" name=icon}}</span>
  {{else if marker}}
    <span class="mrc-audience-challenge__marker" aria-hidden="true">{{marker}}</span>
  {{/if}}
  {{#if title}}
    <h3 class="mrc-audience-challenge__title">{{title}}</h3>
  {{/if}}
  {{#if copy}}
    <p class="mrc-audience-challenge__copy">{{copy}}</p>
  {{/if}}
</article>
