{{!-- Tech stack chip for the toolkit carousel.
      Params: title (required), simple_icon, simple_icon_2, or icon (theme line icon). --}}
<div class="mrc-tech-card">
  {{#if simple_icon}}
    <div class="mrc-tech-card__icons">
      <img src="https://cdn.simpleicons.org/{{simple_icon}}" alt="" width="24" height="24" loading="lazy" decoding="async" />
      {{#if simple_icon_2}}
        <img src="https://cdn.simpleicons.org/{{simple_icon_2}}" alt="" width="24" height="24" loading="lazy" decoding="async" />
      {{/if}}
    </div>
  {{else if icon}}
    <div class="mrc-tech-card__icon">{{> "icon" name=icon}}</div>
  {{/if}}
  <p class="mrc-tech-card__title">{{title}}</p>
</div>
