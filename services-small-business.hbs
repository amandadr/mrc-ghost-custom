{{!< default}}
{{! Small & Medium Businesses — /services/small-businesses/ via routes.yaml.
    Copy: assets/wireframes/raw copy/small-medium-businesses.md + SMB PNGs. }}
{{#contentFor "title"}}Your Website Should Work as Hard as You Do | {{@site.title}}{{/contentFor}}
{{#contentFor "body_class"}} mrc-route-services-small-business{{/contentFor}}
{{#contentFor "head"}}
    {{> "seo-meta"
      description="Practical websites and digital systems for small and medium businesses. Clear explanations, honest recommendations, and tools you can run yourself."
      og_title="Your website should work as hard as you do"
      og_description="You run the business. I help make the technology work for you, not the other way around."
      path="/services/small-businesses/"
    }}
{{/contentFor}}

<main class="site-main mrc-page mrc-page-audience mrc-page-audience--small-business">
  <div class="mrc-audience-breadcrumb-wrap section-light gh-outer">
    <div class="gh-inner">
      {{> "audience-breadcrumb" current_label="Small & Medium Businesses" path="/services/small-businesses/"}}
    </div>
  </div>

  {{! 1. Hero }}
  {{> "audience-hero"
    eyebrow="Small &amp; medium businesses"
    title="Your website should work as hard as you do"
    lead="You run the business. I help make the technology work for you, not the other way around. No jargon, no bloated retainers—just practical digital systems."
    primary_href="/case-studies/"
    primary_text="Work"
    secondary_href="/services/"
    secondary_text="Services"
    ga_audience="small_business"
    ga_label_primary="Work"
    ga_label_secondary="Services"
    fit_heading="Sound familiar?"
    fit_item1="The website no longer reflects the business you've built"
    fit_item2="Customers struggle to find what they need or take the next step"
    fit_item3="Routine work is scattered across too many tools and logins"
  }}

  {{! 2. Recognition }}
  <section class="mrc-audience-challenges section-surface gh-outer" aria-labelledby="mrc-audience-challenges-title">
    <div class="mrc-audience-challenges__inner gh-inner">
      {{> "section-header"
        eyebrow="Recognition"
        heading_id="mrc-audience-challenges-title"
        heading="You're here because something isn't working"
        intro="The business has grown, but the digital tools haven't kept up. The work is scattered and the next step is unclear."
      }}
      <div class="mrc-audience-challenge-grid">
        {{> "audience-challenge" icon="desktop" title="Outgrown site" copy="The website no longer reflects the quality of the business you have built."}}
        {{> "audience-challenge" icon="users" title="Lost leads" copy="Customers are calling to ask questions your website should have already answered."}}
        {{> "audience-challenge" icon="gear" title="Admin fatigue" copy="Routine tasks are scattered across five different logins and spreadsheets."}}
        {{> "audience-challenge" icon="smartphone" title="Mobile mess" copy="The site is hard to use on a phone, which is exactly where most of your customers are looking."}}
        {{> "audience-challenge" icon="key" title="Agency hostage" copy="You're locked into a monthly retainer for a site you can't even edit yourself."}}
        {{> "audience-challenge" icon="compass" title="Invisible online" copy="Competitors with worse services are showing up before you on Google Maps and local searches."}}
      </div>
    </div>
  </section>

  {{! 3. Capabilities }}
  <section class="mrc-section section-light gh-outer" aria-labelledby="mrc-smb-capabilities">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Capabilities"
        heading_id="mrc-smb-capabilities"
        heading="How we can fix it"
        intro="A good website is more than a digital brochure. It's a system that brings in customers, answers their questions, and makes your day easier."
      }}
      <div class="mrc-feature-grid mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "feature-item" icon="document" title="Websites & online stores" body="Custom sites built to sell, take bookings, and represent your business properly."}}
        {{> "feature-item" icon="compass" title="Local search & SEO" body="The technical foundations that help nearby customers find you before they find your competitors."}}
        {{> "feature-item" icon="gear" title="Analytics & automation" body="Clear numbers and simple workflows that save you hours of administrative work every week."}}
        {{> "feature-item" icon="plug" title="Hosting & ongoing support" body="Fast, secure, and maintained. You keep control of the accounts, but you never have to think about the plumbing."}}
      </div>
    </div>
  </section>

  {{! 4. Selected work }}
  {{> "feed-work"
    section_class="section-surface"
    heading_id="mrc-smb-work"
    eyebrow="Work"
    heading="Real problems, solved well"
    intro="Stories from businesses that needed their websites to work harder."
    link_href="/case-studies/"
    link_text="View all"
    limit="3"
  }}

  {{! 5. Mid-page CTA }}
  {{> "cta-section"
    bg_class="section-dark"
    headline="Ready to stop wrestling with tech?"
    subtext="If you're spending more time fighting your digital tools than running your business, we should talk (for free)."
    button_text="Get in touch"
    href="/contact/?audience=small-business"
    ga_event="audience_mid_cta_click"
    ga_label="Get in touch"
    ga_audience="small_business"
    ga_page_section="mid_cta"
  }}

  {{! 6. Resources }}
  {{> "feed-resources"
    section_class="section-light"
    heading_id="mrc-smb-resources"
    eyebrow="Resources"
    heading="Practical guides for busy owners"
    intro="Clear, useful reading that helps you make better decisions."
    link_href="/resources/"
    link_text="View all"
    limit="3"
  }}

  {{! 7. Process }}
  <section class="mrc-section section-surface gh-outer" aria-labelledby="mrc-smb-process">
    <div class="gh-inner">
      {{> "section-header"
        eyebrow="Process"
        heading_id="mrc-smb-process"
        heading="A clear path forward"
        intro="We start with a conversation about what is working and what is not. Then we build a plan you understand for a website you can run yourself."
      }}
      <div class="mrc-process-grid mrc-process-grid--numbered mrc-grid mrc-grid--auto mrc-grid--gap-l">
        {{> "process-step" title="Listen" desc="We start with your goals and frustrations. No technical talk—just a straight conversation about what your business needs."}}
        {{> "process-step" title="Assess" desc="A clear look at what you have online right now, what is working, and what is costing you time or customers."}}
        {{> "process-step" title="Recommend" desc="Honest recommendations sized to your budget and capacity—not a sales pitch for things you don't need."}}
        {{> "process-step" title="Build" desc="We build or repair the parts that matter, with progress you can see along the way."}}
        {{> "process-step" title="Train" desc="You learn how to run what was built, so the site doesn't become someone else's mystery. You own the code and the data."}}
        {{> "process-step" title="Support" desc="Ongoing help when you want it—hosting, updates, and a clear place to ask questions."}}
      </div>
    </div>
  </section>

  {{! 8. Final CTA }}
  {{> "cta-section"
    headline="Let's talk about what your business needs."
    subtext="Start with a conversation. No pressure, no jargon, no hidden fees; just a clear look at what's possible."
    button_text="Contact"
    href="/contact/?audience=small-business"
    secondary_href="/case-studies/"
    secondary_text="Work"
    ga_event="audience_primary_cta_click"
    ga_label="Contact"
    ga_audience="small_business"
    ga_page_section="final_cta"
  }}

  {{! 9. Related audiences }}
  <div class="mrc-audience-nav section-light gh-outer">
    <div class="mrc-audience-nav__inner gh-inner">
      {{> "audience-related-nav" omit="small-business" audience="small_business"}}
    </div>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Websites & Digital Support for Small Businesses",
    "description": "Practical websites and digital systems for small and medium businesses. Clear explanations, honest recommendations, and tools you can run yourself.",
    "provider": {
      "@type": "ProfessionalService",
      "name": "{{@site.title}}",
      "url": "{{@site.url}}"
    },
    "areaServed": ["PEI", "Atlantic Canada", "Canada", "United States"],
    "url": "{{@site.url}}/services/small-businesses/"
  }
  </script>
</main>